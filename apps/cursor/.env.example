# Supabase
NEXT_PUBLIC_SUPABASE_URL=<your_supabase_project_url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your_supabase_publishable_key>
SUPABASE_SECRET_KEY=<your_supabase_secret_key>

# Admins are rows in the public.admins table (see README), not env vars.

# Vercel Firewall — backs the rate limiters in src/lib/rate-limit.ts.
# Configure these rules in Vercel dashboard → Firewall (rate limit IDs):
#   install-per-plugin   3 / 24h
#   install-global       20 / 1h
#   plugin-scan          5 / 1h
#   mcp-moderation       60 / 1h
# In production, no env vars are required (the SDK uses VERCEL_* automatically).
# Set this to a deployed host (e.g. preview URL) to exercise rate limits in
# local dev; otherwise checkRateLimit is a no-op outside production.
NEXT_PUBLIC_VERCEL_FIREWALL_HOST_FOR_DEVELOPMENT=

# Cursor SDK — required for the plugin security scan worker
# (src/lib/plugins/scan.ts, drained from a Supabase Queue by
# /api/queue/plugin-scans/drain). Mint a key at
# https://cursor.com/dashboard/cloud-agents or use a team service-account key.
CURSOR_API_KEY=

# GitHub API token — optional. Without it, unauthenticated GitHub requests
# from the plugin parser and extract scripts are limited to 60/hr.
GITHUB_TOKEN=

# Vercel Web Analytics is enabled in the Vercel dashboard (Project → Analytics)
# and requires no env vars; the @vercel/analytics client is a no-op in dev.

# Shared secret guarding /api/cron/* routes against unauthenticated callers.
CRON_SECRET=

# Community Plugins MCP server (/api/mcp). Comma-separated Supabase OAuth
# client IDs whose access tokens the MCP server accepts and that admins may
# approve on /oauth/consent. Create the client with
# `bun run mcp:create-oauth-client` (see README).
MCP_OAUTH_CLIENT_IDS=
